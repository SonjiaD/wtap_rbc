# Server Configuration
PORT=3001

# Gemini API Key (optional - for AI-powered email generation)
# If not provided, the app will use template-based email generation
GEMINI_API_KEY=your_gemini_api_key_here

# Google Custom Search API Key (optional - for finding real mentors)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here

# Google Custom Search Engine ID (optional - create at: https://cse.google.com/)
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Enable AI features (set to 'true' to use Gemini for enhanced email generation)
USE_AI=true
